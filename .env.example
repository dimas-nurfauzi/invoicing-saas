# Copy to .env (git-ignored) and adjust. All values below are local-dev defaults.

# --- docker compose (PostgreSQL container) ---
POSTGRES_DB=invoicing
POSTGRES_USER=invoicing
POSTGRES_PASSWORD=invoicing
POSTGRES_PORT=5433
# Host port of the app container (docker compose --profile app). Change it if 8080 is taken,
# e.g. by the app running in your IDE.
APP_PORT=8080

# --- application (read by application.yml) ---
DB_URL=jdbc:postgresql://localhost:5433/invoicing
DB_USERNAME=invoicing
DB_PASSWORD=invoicing

# --- JWT (required) ---
# HMAC-SHA256 signing key, at least 32 bytes. The app refuses to start without it.
# Generate your own: openssl rand -base64 32   (never reuse this dev value anywhere real)
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
# Access token lifetime, ISO-8601 duration (default PT1H)
JWT_TTL=PT1H

# --- CORS (browser frontend) ---
# Exact origins allowed to call the tenant API from a browser, comma-separated, no wildcards.
# Empty = CORS off. Local frontend dev server (Vite) runs on http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- API docs ---
# Swagger UI (/swagger-ui.html) and OpenAPI spec (/v3/api-docs). Set false in production.
SPRINGDOC_ENABLED=true

# --- Platform admin (the SaaS operator) ---
# Created at startup if both are set and the email doesn't exist yet. Password: 12-72 chars.
# Leave empty to skip. Never commit real values.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Public tenant signup (POST /api/tenants). false = only platform admins create tenants.
TENANT_SIGNUP_ENABLED=true

# --- Overdue job ---
# Spring cron (sec min hour day month weekday); "-" disables. Zone decides what "today" is.
OVERDUE_CRON=0 5 0 * * *
OVERDUE_ZONE=Asia/Jakarta

# --- AI invoice drafts (Claude API) ---
# Leave ANTHROPIC_API_KEY empty to disable the feature (POST /api/invoices/ai-draft → 503).
# Never commit a real key. Tests never call the API.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=low
